# ── Deployment ───────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS.
# Leave blank in local dev (Vite proxy handles it, CORS isn't needed).
# Example: https://your-app.vercel.app,https://www.yourdomain.com
FRONTEND_ORIGIN=

# ── Free LLM providers (set at least one) ───────────────
# Groq:        https://console.groq.com/keys
GROQ_API_KEY=

# Gemini:      https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter:  https://openrouter.ai/keys  (use ":free" models)
OPENROUTER_API_KEY=

# Ollama (fully local, optional): leave blank to disable
OLLAMA_BASE_URL=

# ── Optional search provider ──────────────────────────────
# Falls back to ddgs metasearch (DuckDuckGo / Bing / Brave / …) then Wikipedia.
# Free tier: https://tavily.com
TAVILY_API_KEY=

# ── Role → model routing ─────────────────────────────────
# Comma-separated fallback chain, "provider:model".
# Providers without a key are skipped automatically.
MODEL_PLANNER=groq:llama-3.3-70b-versatile,gemini:gemini-2.5-flash,openrouter:meta-llama/llama-3.3-70b-instruct:free
MODEL_FAST=groq:llama-3.1-8b-instant,gemini:gemini-2.5-flash-lite,openrouter:meta-llama/llama-3.3-70b-instruct:free
MODEL_WRITER=gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile,openrouter:meta-llama/llama-3.3-70b-instruct:free
MODEL_CRITIC=groq:openai/gpt-oss-120b,groq:llama-3.3-70b-versatile,gemini:gemini-2.5-flash
MODEL_ANALYST=groq:llama-3.3-70b-versatile,gemini:gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# ── Orchestration ─────────────────────────────────────────
MAX_REVISIONS=2
PASS_SCORE=8.0
SEARCH_RESULTS_PER_QUERY=5
MAX_SOURCES=18
